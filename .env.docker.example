DOCKER_APP_URL=http://localhost:8080
DOCKER_APP_PORT=8080

# Required. Generate one with:
# docker compose --env-file .env.docker run --rm --entrypoint php app artisan key:generate --show
DOCKER_APP_KEY=

DOCKER_DB_DATABASE=kingdom_idle
DOCKER_DB_USERNAME=kingdom
DOCKER_DB_PASSWORD=change_me
DOCKER_DB_ROOT_PASSWORD=change_root_me

DOCKER_RUN_MIGRATIONS=true
DOCKER_RUN_SEEDERS=true
DOCKER_RUN_OPTIMIZE=true
